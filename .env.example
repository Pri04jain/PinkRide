# ============================================================
# PinkRide Backend — Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to Git
# ============================================================

# App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
#
# SUPABASE_URL        — looks like https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY — "service_role" key (not the anon key)
#                        This bypasses RLS and is safe for backend use only.
#                        Never expose this in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# SUPABASE_STORAGE_BUCKET — name of the Storage bucket for driver document uploads.
# Create it in: Supabase dashboard → Storage → New bucket (recommended: private).
# Leave unset in development — files will be stored locally under /uploads/ instead.
# SUPABASE_STORAGE_BUCKET=pinkride-documents

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_REFRESH_EXPIRES_IN=30d

# ── OTP / SMS (MSG91) ─────────────────────────────────────────
# In development, OTPs are printed to console — no SMS needed.
# Sign up at msg91.com for production keys.
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=PINKRD
MSG91_TEMPLATE_ID=your_otp_template_id
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Payments (Razorpay) ───────────────────────────────────────
# In development, payment flow runs in mock mode without these.
# Sign up at razorpay.com for test keys (start with rzp_test_).
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Maps (Google) ─────────────────────────────────────────────
# Used server-side to calculate real driving distance + duration for fare calculation.
# Without this, the server falls back to a Haversine straight-line estimate (×1.35 road factor).
# Enable the Distance Matrix API at: console.cloud.google.com
# Restrict the key to Distance Matrix API + your server IP for production.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Maps (Mapbox) ─────────────────────────────────────────────
# Used in the frontend (Day 6). Get a free token at mapbox.com.
MAPBOX_TOKEN=your_mapbox_public_token

# ── Platform Config ───────────────────────────────────────────
PLATFORM_FEE_PERCENT=5
CANCELLATION_FEE_INR=50
DRIVER_CANCELLATION_FINE_INR=150
WALLET_MIN_TOPUP_INR=100
RIDE_MATCH_WINDOW_MINUTES=30
RIDE_MATCH_RESPONSE_DEADLINE_MINUTES=10
FACE_VERIFY_MAX_RETRIES=5
ROUTE_DEVIATION_ALERT_METERS=500
ROUTE_DEVIATION_AUTO_ALERT_SECONDS=120
CO_PASSENGER_MAX_REJECTIONS=2

# ── Face Verification (AWS Rekognition) ──────────────────────
#
# FACE_VERIFICATION_MOCK=true  → bypasses all AWS calls, always returns success.
#                                Use this in development / CI.
# FACE_VERIFICATION_MOCK=false → enforces real AWS Rekognition checks (production default).
#
# Do NOT rely on NODE_ENV to control this. Set it explicitly.
# In production, leave FACE_VERIFICATION_MOCK unset or set to false.
FACE_VERIFICATION_MOCK=true
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REKOGNITION_COLLECTION_ID=pinkride-faces

# ── Push Notifications (Firebase) ────────────────────────────
#
# FIREBASE_PUSH_ENABLED=false → pushes are console.log only (dev default)
# FIREBASE_PUSH_ENABLED=true  → real Firebase pushes sent via Admin SDK
#
# Credentials — pick ONE of the three options below:
#
# Option 1 — Inline JSON (recommended for Railway/Render/cloud deployments)
#   Paste the full contents of your serviceAccount.json as a single-line string.
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Option 2 — File path (convenient for local dev)
#   FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
#
# Option 3 — Application Default Credentials
#   Leave both above unset when running on GCP/Cloud Run with ADC configured.
#
# Get your service account key from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PUSH_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=
