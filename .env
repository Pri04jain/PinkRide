SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl2d2JleGl6aWJzbGt3dXhud2RnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTgyMTc2MCwiZXhwIjoyMTAxMzk3NzYwfQ.gej5s7FOiwnYwKGgIcAsectlg1Izy-51YP1n0YmYsAI

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=p194e96d80832d5bfcbc23d92ca5088c8dcb023249b37bc180acbb5ad759cc544
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=24640116138ed1bc8eb4dac248408cd50278cfc223f23144abcfc443e79d9f9e
JWT_REFRESH_EXPIRES_IN=30d

# ── OTP / SMS (MSG91) ─────────────────────────────────────────
# In development, OTPs just print to console — no real SMS sent
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=PINKRD
MSG91_TEMPLATE_ID=your_otp_template_id
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Payments (Razorpay) ───────────────────────────────────────
# In development, payment runs in mock mode without these
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Maps (Google) ─────────────────────────────────────────────
# Used SERVER-SIDE ONLY to calculate real driving distance for fares.
# Without this key the backend falls back to Haversine (straight-line ×1.35).
# Enable "Distance Matrix API" at console.cloud.google.com
# Replace the placeholder below with your actual key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Face Verification (AWS Rekognition) ──────────────────────
# FACE_VERIFICATION_MOCK=true bypasses all AWS calls (dev/demo default).
# Mock mode always returns success so the flow works without AWS credentials.
# In production with real AWS keys, it calls actual Rekognition service.
FACE_VERIFICATION_MOCK=true
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REKOGNITION_COLLECTION_ID=pinkride-faces

# ── Push Notifications (Firebase) ────────────────────────────
# FIREBASE_PUSH_ENABLED=false means pushes just log to console (dev default).
FIREBASE_PUSH_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Platform Config ───────────────────────────────────────────
PLATFORM_FEE_PERCENT=5
CANCELLATION_FEE_INR=50
DRIVER_CANCELLATION_FINE_INR=150
WALLET_MIN_TOPUP_INR=100
RIDE_MATCH_WINDOW_MINUTES=30
RIDE_MATCH_RESPONSE_DEADLINE_MINUTES=10
FACE_VERIFY_MAX_RETRIES=5
ROUTE_DEVIATION_ALERT_METERS=500
ROUTE_DEVIATION_AUTO_ALERT_SECONDS=120
CO_PASSENGER_MAX_REJECTIONS=2
